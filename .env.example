# Порт Node-приложения (nginx проксирует на него)
PORT=3000
# development | production
NODE_ENV=development
# Длинная случайная строка: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me
# Ставить cookie с флагом Secure (true в проде за HTTPS; в локальной разработке по http — false)
COOKIE_SECURE=false
# Путь к SQLite
DB_PATH=./data/app.db
# ---- Оплата картами («Мир», Visa, Mastercard) через ЮKassa ----
# Ключи: личный кабинет ЮKassa → Интеграция → Ключи API. НИКОГДА не коммитить!
# Если YOOKASSA_SHOP_ID/YOOKASSA_SECRET_KEY пустые — работает MOCK-режим: тестовая страница оплаты, деньги не списываются.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Публичный адрес сайта (https, без слэша в конце) — для return_url. На Render по умолчанию берётся RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=http://localhost:3000
# (необязательно) Чек по 54-ФЗ: включить, когда известна налоговая настройка продавца. См. README, src/receipt.js
YOOKASSA_RECEIPT=false
# 1 — без НДС, 2 — 0%, 3 — 10%, 4 — 20% ... (справочник ЮKassa)
YOOKASSA_VAT_CODE=1
# 1 ОСН, 2 УСН доходы, 3 УСН доходы-расходы, 5 ЕСХН, 6 Патент. Пусто — используется настройка магазина в кабинете
YOOKASSA_TAX_SYSTEM_CODE=
# service | commodity ...; full_payment | full_prepayment ...
YOOKASSA_PAYMENT_SUBJECT=service
YOOKASSA_PAYMENT_MODE=full_payment
